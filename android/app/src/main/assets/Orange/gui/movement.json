    { "id": "autoGlide", "name": "自动滑翔", "icon": "FEATHER", "keybind": true, "settings": [] },
    { "id": "autoSwim", "name": "自动游泳", "icon": "FEATHER", "keybind": true, "settings": [] },
    { "id": "waterWalking", "name": "水上行走", "icon": "STEPS", "keybind": true, "settings": [] },
